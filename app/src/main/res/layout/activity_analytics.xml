<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Navigation Header -->
        <TextView
            android:id="@+id/tv_back_analytics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK TO DASHBOARD"
            android:textColor="@color/green_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Financial Audit"
            android:textColor="#EFEFEF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A breakdown of your life choices."
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Lifetime Spending Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIFETIME SPENDING"
                android:textColor="#888888"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_total_spent_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textColor="@color/green_primary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_stat_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing transactions..."
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Sassy Audit Box (Yellow "Official Memo" Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_dashboard_card"
            android:padding="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ "
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_piggy_audit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The piggy is reviewing your receipts..."
                android:textColor="#FFCC00"
                android:textStyle="italic"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Category Graph Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPENDING CONCENTRATION"
            android:textColor="#666666"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/layout_analytics_graph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card"
            android:padding="16dp" />

        <!-- Transaction Log Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FULL TRANSACTION LOG"
            android:textColor="#666666"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.1" />

        <!-- Nested List -->
        <ListView
            android:id="@+id/lv_full_history"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="@drawable/bg_dashboard_card"
            android:divider="#333333"
            android:dividerHeight="1dp"
            android:padding="8dp"
            android:nestedScrollingEnabled="true" />

        <!-- Footer Margin -->
        <View
            android:layout_width="match_parent"
            android:layout_height="48dp" />

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── TOP BAR ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp">

            <!-- Default profile avatar — tappable, goes to Profile -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_default_avatar"
                android:layout_marginEnd="10dp"
                android:contentDescription="Profile"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hey, Friend 👋"
                android:textColor="#EFEFEF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Hamburger menu — ImageView with built-in Android menu icon -->
            <ImageView
                android:id="@+id/iv_hamburger"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_menu_white"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Menu"
                app:tint="#EFEFEF" />

        </LinearLayout>

        <!-- ── SETUP PROMPT (hidden when budget is set) ── -->
        <LinearLayout
            android:id="@+id/layout_setup_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐷"
                android:textSize="80sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I need your budget first."
                android:textColor="#8AD167"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How can I judge your spending if I don't know your budget? Set it up in Profile."
                android:textColor="#EFEFEF"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <Button
                android:id="@+id/btn_setup_now"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Set Up Budget"
                android:textColor="#1C1C1A"
                android:textStyle="bold"
                android:backgroundTint="#8AD167"/>

        </LinearLayout>

        <!-- ── MAIN CONTENT (shown when budget is set) ── -->
        <LinearLayout
            android:id="@+id/layout_main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Piggy character block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_piggy_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐷"
                    android:textSize="80sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Speech bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_speech_bubble"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tv_piggy_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Budget looking healthy. Don't ruin it."
                        android:textColor="#1C1C1A"
                        android:textSize="14sp"
                        android:textStyle="italic"
                        android:gravity="center"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Budget card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_card"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REMAINING BALANCE"
                    android:textColor="#8AD167"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_remaining_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"
                    android:textColor="#8AD167"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2A2A28"
                    android:layout_marginBottom="12dp"/>

                <!-- Bottom row: daily limit on left, + Add Money on right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_daily_limit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Daily limit: ₱0.00"
                        android:textColor="#DFDE9F"
                        android:textSize="13sp"/>

                    <Button
                        android:id="@+id/btn_add_money"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="+ Add Money"
                        android:textColor="#1C1C1A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:backgroundTint="#8AD167"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- Expense Logger -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOG AN EXPENSE"
                    android:textColor="#8AD167"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Amount row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <EditText
                        android:id="@+id/et_amount"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:hint="₱ Amount"
                        android:textColorHint="#555555"
                        android:textColor="#EFEFEF"
                        android:textSize="18sp"
                        android:inputType="numberDecimal"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/et_category"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:hint="Category (optional)"
                        android:textColorHint="#555555"
                        android:textColor="#EFEFEF"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_amount_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btn_log_expense"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Log Expense"
                    android:textColor="#1C1C1A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#8AD167"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ANALYTICS"
                    android:textColor="@color/green_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/tv_view_all_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Full →"
                    android:textColor="@color/green_primary"
                    android:textSize="12sp"
                    android:alpha="0.8"
                    android:textStyle="bold"
                    android:layout_gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPENDING BREAKDOWN"
                        android:textColor="#8AD167"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/layout_category_chart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- This space is empty now, but our Activity code
                         will fill it with bars as you spend money. -->

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp">

                <ProgressBar
                    android:id="@+id/pb_budget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPENSES"
                    android:textStyle="bold"
                    android:textColor="#8AD167"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <ListView
                    android:id="@+id/lv_expense_history"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:nestedScrollingEnabled="true" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_add_money.xml

    Custom layout for the "Add Money" AlertDialog.
    Themed to match the dark SpendSass UI — no white flash.
    Place in res/layout/.

    IDs used in DashboardActivity:
      et_dialog_amount   — amount input
      tv_dialog_error    — validation error (hidden by default)
      btn_dialog_confirm — "Add" button
      btn_dialog_cancel  — "Cancel" button
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#242422"
    android:padding="24dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💰"
            android:textSize="24sp"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Money"
                android:textColor="#EFEFEF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top up your spending balance"
                android:textColor="#555555"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Amount label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AMOUNT (₱)"
        android:textColor="#8AD167"
        android:textSize="11sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Amount input -->
    <EditText
        android:id="@+id/et_dialog_amount"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="e.g. 500"
        android:textColorHint="#555555"
        android:textColor="#EFEFEF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:inputType="numberDecimal"
        android:background="@drawable/bg_input_field"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- Error message — hidden by default -->
    <TextView
        android:id="@+id/tv_dialog_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF6B6B"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Piggy note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This adds to your current balance only — your total budget ceiling stays the same."
        android:textColor="#555555"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="24dp"/>

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Cancel -->
        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#EFEFEF"
            android:textSize="14sp"
            android:backgroundTint="#2A2A28"
            android:layout_marginEnd="8dp"/>

        <!-- Confirm -->
        <Button
            android:id="@+id/btn_dialog_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Add"
            android:textColor="#1C1C1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#8AD167"/>

    </LinearLayout>

</LinearLayout>
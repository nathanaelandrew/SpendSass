<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════════════ -->
        <!--  PAGE 0: WELCOME                              -->
        <!-- ══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/page_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐷"
                android:textSize="80sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SpendSass"
                android:textColor="#8AD167"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your brutally honest budget buddy."
                android:textColor="#DFDE9F"
                android:textSize="14sp"
                android:layout_marginBottom="40dp"/>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:background="#8AD167"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:text="💸"
                        android:textSize="20sp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Track spending in seconds — no spreadsheets."
                        android:textColor="#EFEFEF"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:text="😬"
                        android:textSize="20sp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Get real-time reactions from a sarcastic piggy bank."
                        android:textColor="#EFEFEF"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:text="🎯"
                        android:textSize="20sp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stay within your budget without crying (too much)."
                        android:textColor="#EFEFEF"
                        android:textSize="14sp"/>
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btn_welcome_next"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Let's Go →"
                android:textColor="#1C1C1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#8AD167"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_already_have_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I already have an account"
                android:textColor="#DFDE9F"
                android:textSize="13sp"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════ -->
        <!--  PAGE 1: MEET THE PIGGY + FINAL CTA           -->
        <!-- ══════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/page_piggy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐷"
                android:textSize="100sp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meet Your Piggy"
                android:textColor="#8AD167"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_speech_bubble"
                android:padding="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oink. I see everything.\"
                    android:textColor="#1C1C1A"
                    android:textSize="16sp"
                    android:textStyle="bold|italic"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Every time you spend money, I react. Responsibly spent? I'm delighted. Wasted on another coffee? I'm... less delighted."
                    android:textColor="#333333"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="36dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😄"
                        android:textSize="28sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthy"
                        android:textColor="#8AD167"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😬"
                        android:textSize="28sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Careful"
                        android:textColor="#DFDE9F"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😤"
                        android:textSize="28sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Busted"
                        android:textColor="#FF6B6B"
                        android:textSize="11sp"/>
                </LinearLayout>

            </LinearLayout>

            <!--
                Primary CTA: calls presenter.onGetStartedClicked() → navigateToRegister()
                Budget setup happens later inside the app (Profile/Settings).
            -->
            <Button
                android:id="@+id/btn_get_started"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Get Started 🐷"
                android:textColor="#1C1C1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#8AD167"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_piggy_back"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="← Back"
                android:textColor="#EFEFEF"
                android:backgroundTint="@android:color/transparent"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_piggy_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? Log in"
                android:textColor="#DFDE9F"
                android:textSize="13sp"
                android:padding="8dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
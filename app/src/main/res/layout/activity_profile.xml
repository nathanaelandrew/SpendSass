<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="48dp">

        <!-- ── TOP BAR ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textColor="#8AD167"
                android:textSize="15sp"
                android:padding="4dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profile &amp; Settings"
                android:textColor="#EFEFEF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log out"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:padding="4dp"/>

        </LinearLayout>

        <!-- ── USER HEADER ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <!-- Default profile avatar circle -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_default_avatar"
                android:layout_marginBottom="10dp"
                android:contentDescription="Profile picture"/>

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friend"
                android:textColor="#DFDE9F"
                android:textSize="20sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ── BUDGET SETTINGS CARD ─────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUDGET SETTINGS"
                android:textColor="#8AD167"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Total Budget -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL BUDGET (₱)"
                android:textColor="#EFEFEF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_budget"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. 10000"
                android:textColorHint="#555555"
                android:textColor="#EFEFEF"
                android:textSize="16sp"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_budget_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:layout_marginBottom="14dp"
                android:visibility="gone"/>

            <!-- Daily Limit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DAILY SPENDING LIMIT (₱)"
                android:textColor="#EFEFEF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_daily_limit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. 500"
                android:textColorHint="#555555"
                android:textColor="#EFEFEF"
                android:textSize="16sp"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_daily_limit_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:layout_marginBottom="14dp"
                android:visibility="gone"/>

            <!-- Savings Goal -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAVINGS GOAL (₱) — optional"
                android:textColor="#EFEFEF"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/et_savings_goal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. 3000"
                android:textColorHint="#555555"
                android:textColor="#EFEFEF"
                android:textSize="16sp"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_savings_goal_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Piggy tip card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_tip_card"
            android:padding="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:gravity="top">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐷"
                android:textSize="16sp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="1dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Changing your budget resets your balance to the new total. Choose wisely."
                android:textColor="#1C1C1A"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.3"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save Settings"
            android:textColor="#1C1C1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#8AD167"
            android:layout_marginBottom="40dp"/>

    </LinearLayout>
</ScrollView>
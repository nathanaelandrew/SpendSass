<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SpendSass" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#8AD167</item>
        <item name="colorPrimaryDark">#1C1C1A</item>
        <item name="colorAccent">#DFDE9F</item>
        <item name="android:windowBackground">#1C1C1A</item>
        <item name="android:statusBarColor">#1C1C1A</item>
    </style>

    <style name="SpendSassDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#242422</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColor">#EFEFEF</item>
        <item name="android:textColorPrimary">#EFEFEF</item>
        <item name="android:listDivider">@android:color/transparent</item>
        <item name="colorAccent">#8AD167</item>
        <item name="buttonBarButtonStyle">@style/SpendSassDialogButton</item>
